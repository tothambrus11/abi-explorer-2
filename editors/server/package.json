  "description": "A language server that shows how clang lays out C and C++ records: sizes, offsets and padding, in hovers and inlay hints.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "abi-explorer-lsp": "bin/abi-explorer-lsp.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "exports": {
    "./protocol": "./src/protocol.ts",
    "./layoutModel": "./src/layout/layoutModel.ts",
    "./format": "./src/layout/format.ts",
    "./commandLine": "./src/compile/commandLine.ts",
    "./engineFiles": "./src/engine/engineFiles.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
