{
  "name": "abi-explorer-editors",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "panel",
    "vscode"
  ],
  "scripts": {
    "build": "npm run build -w vscode",
    "test": "vitest run",
    "check": "tsc -p . && tsc -p shared && tsc -p server && tsc -p panel && tsc -p vscode",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:build-systems": "vitest run --config vitest.build-systems.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
