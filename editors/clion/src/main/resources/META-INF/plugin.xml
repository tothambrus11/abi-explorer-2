<idea-plugin>
  <!-- Marketplace IDs may not contain the IDE's name, and never change once published. -->
  <id>org.hylo-lang.abi-explorer</id>
  <name>ABI Explorer</name>
  <vendor url="https://github.com/tothambrus11/abi-explorer-2">Hylo</vendor>
  <description><![CDATA[
    Sizes, offsets and padding of C and C++ structs, from the project's own compiler and flags:
    in quick documentation and in the <b>Struct Layout</b>
    tool window, which follows the caret. Intentions reorder a struct's members by alignment where
    that saves space and pin its layout with <code>static_assert</code>, and a setting lays structs
    out for another target.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lsp</depends>
  <!-- CLion itself, and its project model (OCWorkspace) for each file's compiler and
       switches, in both C/C++ engines. Not com.intellij.modules.cidr.lang: that is the
       classic engine, which CLion Nova (the default since 2025.3) does not load, so a
       plugin requiring it would not load there at all. -->
  <depends>com.intellij.modules.clion</depends>

  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.serverSupportProvider implementation="abiexplorer.clion.AbiExplorerLspSupport"/>
    <toolWindow id="Struct Layout" anchor="right" icon="AllIcons.Toolwindows.ToolWindowStructure"
                factoryClass="abiexplorer.clion.LayoutToolWindowFactory"/>
    <notificationGroup id="ABI Explorer" displayType="BALLOON"/>
    <projectConfigurable parentId="tools" id="abiexplorer.settings" displayName="ABI Explorer"
                         instance="abiexplorer.clion.AbiExplorerConfigurable"/>
  </extensions>

  <projectListeners>
    <listener class="abiexplorer.clion.WorkspaceCompileCommands"
              topic="com.jetbrains.cidr.lang.workspace.OCWorkspaceListener"/>
  </projectListeners>
</idea-plugin>
