{
  "name": "abi-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Visualize C/C++ struct layouts for any LLVM target \u2014 clang compiled to WebAssembly, running in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fixtures": "ABIX_CAPTURE=1 vitest run tests/unit/fixtures.capture.test.ts tests/unit/corpus.capture.test.ts",
    "abi:fetch": "node tools/fetch-abi-module.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.31.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "monaco-editor": "^0.56.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "valibot": "^1.4.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "dependencies": {
    "dockview": "^8.1.0",
    "vanilla-colorful": "^0.7.2"
  }
}
